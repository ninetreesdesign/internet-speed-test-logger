<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ninetreesdesign.speedmon-bg</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/davidsmithfinzi/Dropbox/Internet Speed Test Log/speedmon_bg.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/davidsmithfinzi/Dropbox/Internet Speed Test Log</string>

  <!-- launchd has a minimal PATH; include ~/go/bin for M-Lab ndt7-client. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/davidsmithfinzi/go/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- speedmon_bg.py contains its own hourly loop; restart only after failure/exit. -->
  <key>KeepAlive</key>
  <true/>

  <key>RunAtLoad</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>300</integer>

  <key>StandardOutPath</key>
  <string>/Users/davidsmithfinzi/Dropbox/Internet Speed Test Log/speedmon_launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/davidsmithfinzi/Dropbox/Internet Speed Test Log/speedmon_launchd.log</string>
</dict>
</plist>
